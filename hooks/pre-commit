#!/usr/bin/env bash
# Research-project pre-commit hook.
#
# Two parts, and the split is deliberate. Mechanical failures BLOCK, because they
# are objective. Bookkeeping only REMINDS, because whether a run produced a belief
# worth recording is a judgement. A hook that blocks on judgement gets bypassed
# with --no-verify once and then ignored forever, taking the real failures with it.
#
# Install:  ./hooks/install.sh     Bypass once:  git commit --no-verify
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# --- Hard gate ------------------------------------------------------------
if [[ -x ./check.sh ]]; then
    if ! ./check.sh; then
        echo
        echo "pre-commit: checks failed. Fix them, or use --no-verify if you are"
        echo "deliberately committing work in progress."
        exit 1
    fi
fi

# --- Reminders ------------------------------------------------------------
staged="$(git diff --cached --name-only)"
[[ -z "$staged" ]] && exit 0

reminders=()
note() { reminders+=("$1"); }
has() { grep -qE "$1" <<<"$staged"; }
list() { grep -E "$1" <<<"$staged" | head -3 | tr '\n' ' '; }

if has '^(results|scripts|src)/' && ! has '^TREE\.md$'; then
    note "Experiment code or results changed ($(list '^(results|scripts|src)/')) but TREE.md did not.
    Does an experiment node move to [done], or has a claim appeared that needs recording?"
fi

if has '^results/' && ! has '^(RESEARCH_LOG|TREE)\.md$'; then
    note "New or changed results ($(list '^results/')) with no tree or log update.
    A null or inconclusive result still counts as a completed experiment."
fi

if has '^\.claude/skills/' && ! has '^(AGENTS\.md|README\.md)$'; then
    note "A skill changed ($(list '^\.claude/skills/')).
    Do AGENTS.md and the README still describe it correctly?"
fi

# Only worth raising when a result that already backs a recorded claim is being
# rewritten. Firing whenever code and results move together would nag on the
# modal correct commit, which teaches people to skim the whole block.
# Compare against the COMMITTED tree, and only for results being MODIFIED: a new
# result arriving with its new citation is ordinary work, not a claim at risk.
committed_tree="$(git show HEAD:TREE.md 2>/dev/null || true)"
if [[ -n "$committed_tree" ]]; then
    while IFS= read -r artefact; do
        [[ -z "$artefact" ]] && continue
        if grep -qF "$artefact" <<<"$committed_tree"; then
            note "$artefact already backs a claim in TREE.md and is being rewritten.
    Re-run falsify or validate-claims for any claim resting on it."
        fi
    done < <(git diff --cached --name-only --diff-filter=M | grep -E '^results/' || true)
fi

# Whether prose reads clearly to a research partner outside this session is a
# judgement, so no check here
# makes it. What IS mechanical is whether an independent reader has read THIS
# version: reviews record the hash of the text they were written about, so a
# review that no longer matches is visibly stale rather than silently wrong.
# A reminder, never a gate — a semantic verdict that can block gets bypassed
# once and then forever.
# Only for projects that have adopted the reader channel: a project with no
# reviews/ directory never opted in, and nagging it on every commit forever is
# how a reminder block teaches people to skim. Discovery belongs in the skill
# and in `research_graph.py review`, not here.
if [[ -d reviews ]]; then
for doc in TREE.md RESEARCH_LOG.md; do
    grep -qx "$doc" <<<"$staged" || continue
    slug="$(tr '[:upper:]' '[:lower:]' <<<"$doc" | sed 's/[^a-z0-9]\+/-/g; s/^-//; s/-$//')"
    review="reviews/${slug}.json"
    if [[ ! -f "$review" ]]; then
        note "$doc changed and no independent reader has read it, though this
    project reviews its other documents.
    uv run scripts/research_graph.py review --run $doc"
    elif command -v python3 >/dev/null 2>&1; then
        reviewed="$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('sha256',''))" "$review" 2>/dev/null || true)"
        actual="$(python3 -c "import hashlib,sys; print(hashlib.sha256(open(sys.argv[1],'rb').read()).hexdigest())" "$doc" 2>/dev/null || true)"
        if [[ -n "$reviewed" && -n "$actual" && "$reviewed" != "$actual" ]]; then
            note "$doc has changed since a reader last read it, so $review is stale.
    When the text settles: uv run scripts/research_graph.py review --run $doc"
        fi
    fi
done
fi

# A document that carries an `updated:` date should have it bumped in the same
# commit that changes the document. STALE-002 catches this later; here it is
# still cheap to fix.
while IFS= read -r doc; do
    [[ -f "$doc" ]] || continue
    # Frontmatter only: the file must open with --- and we stop at the closing ---.
    head -1 "$doc" | grep -q '^---$' || continue
    declared="$(sed -n '2,/^---$/p' "$doc" | sed -n 's/^updated:[[:space:]]*\([0-9-]\{10\}\).*/\1/p' | head -1)"
    [[ -z "$declared" ]] && continue
    if [[ "$declared" != "$(date +%F)" ]]; then
        note "$doc says 'updated: $declared' but is changing today.
    Bump it to $(date +%F) if the content now reflects newer data."
    fi
done < <(grep -E '\.md$' <<<"$staged" || true)

if (( ${#reminders[@]} )); then
    echo
    echo "pre-commit: ${#reminders[@]} thing(s) worth checking before you finish."
    echo "These do not block the commit."
    for r in "${reminders[@]}"; do
        echo "  - $r"
    done
fi

exit 0
