# Names only, never values. This file is committed so a fresh clone or a
# cloud runner knows what to set; copy it to .env and fill it in (.env
# stays gitignored). Read these through one typed settings object built
# with pydantic-settings, not os.environ.get at the point of use — the
# experiment-engineering skill shows the pattern. A key that reaches git
# history is burned: rotate it; deleting the commit is not enough.
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
HF_TOKEN=
